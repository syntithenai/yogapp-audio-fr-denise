      "durationSec": 6.552
    },
    {
      "index": 25,
      "text": "[pause : 40]",
      "file": "c025.ogg",
      "durationSec": 3.912
    },
    {
      "index": 26,
      "text": "Si votre esprit réfléchit à nouveau, faites-y un signe de tête et retournez à l'étagère.",
      "file": "c026.ogg",
      "durationSec": 9.792
    },
    {
      "index": 27,
      "text": "[pause : 53]",
      "file": "c027.ogg",
      "durationSec": 4.296
    },
    {
      "index": 28,
      "text": "Sentez le matelas ou la chaise vous retenir.",
