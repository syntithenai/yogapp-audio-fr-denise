    },
    {
      "index": 7,
      "text": "[pause : 26]",
      "file": "c007.ogg",
      "durationSec": 4.104
    },
    {
      "index": 8,
      "text": "Encore.",
      "file": "c008.ogg",
      "durationSec": 2.688
    },
    {
      "index": 9,
      "text": "[pause : 26]",
      "file": "c009.ogg",
      "durationSec": 4.104
    },
    {
      "index": 10,
      "text": "Laissez les épaules tomber.",
      "file": "c010.ogg",
      "durationSec": 3.984
    },
    {
      "index": 11,
      "text": "Laissez le ventre ramollir.",
      "file": "c011.ogg",
      "durationSec": 4.272
    },
    {
      "index": 12,
      "text": "[pause : 33]",
      "file": "c012.ogg",
      "durationSec": 3.936
    },
    {
      "index": 13,
      "text": "Que la journée soit finie pour le moment.",
      "file": "c013.ogg",
      "durationSec": 4.848
    },
    {
      "index": 14,
      "text": "Ce qui est arrivé est arrivé.",
      "file": "c014.ogg",
      "durationSec": 4.368
    },
    {
      "index": 15,
      "text": "Ce qui reste peut attendre jusqu'au matin.",
      "file": "c015.ogg",
      "durationSec": 5.496
    },
    {
      "index": 16,
      "text": "[pause : 33]",
      "file": "c016.ogg",
      "durationSec": 3.936
    },
    {
      "index": 17,
      "text": "En expirant, imaginez placer des tâches sur une étagère.",
      "file": "c017.ogg",
      "durationSec": 7.632
    },
    {
      "index": 18,
      "text": "Un par un. Pas de drame. Asseyez-vous simplement.",
      "file": "c018.ogg",
      "durationSec": 9.36
    },
    {
      "index": 19,
      "text": "[pause : 53]",
      "file": "c019.ogg",
      "durationSec": 4.296
    },
    {
      "index": 20,
      "text": "Inspirez quatre. Expirez six.",
      "file": "c020.ogg",
      "durationSec": 6.552
    },
    {
      "index": 21,
      "text": "[pause : 33]",
      "file": "c021.ogg",
      "durationSec": 3.936
    },
    {
      "index": 22,
      "text": "Adoucit le visage.",
      "file": "c022.ogg",
      "durationSec": 3.624
    },
    {
      "index": 23,
      "text": "Baissez les épaules.",
      "file": "c023.ogg",
      "durationSec": 3.48
    },
    {
      "index": 24,
      "text": "Des armes lourdes. Jambes lourdes.",
