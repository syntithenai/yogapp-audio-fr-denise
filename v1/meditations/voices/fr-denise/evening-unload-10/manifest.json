  "chunks": [
    {
      "index": 0,
      "text": "Accueillir.",
      "file": "c000.ogg",
      "durationSec": 2.88
    },
    {
      "index": 1,
      "text": "Prenez le temps d'arriver.",
      "file": "c001.ogg",
      "durationSec": 3.84
    },
    {
      "index": 2,
      "text": "Asseyez-vous ou allongez-vous avec un soutien.",
      "file": "c002.ogg",
      "durationSec": 5.784
    },
    {
      "index": 3,
      "text": "Fermez les yeux si vous vous sentez en sécurité.",
      "file": "c003.ogg",
      "durationSec": 5.904
    },
    {
      "index": 4,
      "text": "Ressentez le contact avec le sol.",
      "file": "c004.ogg",
      "durationSec": 5.16
    },
    {
      "index": 5,
      "text": "Inspirez lentement.",
      "file": "c005.ogg",
      "durationSec": 3.408
    },
    {
      "index": 6,
      "text": "Expirez plus longtemps.",
      "file": "c006.ogg",
