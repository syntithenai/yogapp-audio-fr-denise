    {
      "index": 6,
      "text": "Imaginez-vous assis près d’une fenêtre par une journée calme et pluvieuse.",
      "file": "c006.ogg",
      "durationSec": 7.704
    },
    {
      "index": 7,
      "text": "Le verre est cool. Monde doux dehors.",
