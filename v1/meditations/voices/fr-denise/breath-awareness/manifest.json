{
  "id": "breath-awareness",
  "voiceId": "fr-denise",
  "edgeVoice": "fr-FR-DeniseNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 133,
  "chunks": [
    {
      "index": 0,
      "text": "Installez-vous dans une posture stable.",
      "file": "c000.ogg",
      "durationSec": 4.944
    },
    {
      "index": 1,
      "text": "Dos haut mais non rigide.",
      "file": "c001.ogg",
      "durationSec": 4.056
    },
    {
      "index": 2,
      "text": "Portez votre attention sur la respiration telle qu’elle est déjà.",
      "file": "c002.ogg",
      "durationSec": 6.744
    },
    {
      "index": 3,
      "text": "Ne le changez pas encore. Regardez simplement.",
      "file": "c003.ogg",
      "durationSec": 7.536
    },
    {
      "index": 4,
      "text": "Ressentez la fraîcheur de l’inspiration au niveau des narines.",
      "file": "c004.ogg",
      "durationSec": 7.056
    },
    {
      "index": 5,
      "text": "Ressentez la chaleur de l’expiration.",
      "file": "c005.ogg",
      "durationSec": 5.184
    },
    {
      "index": 6,
      "text": "Ou remarquez la montée et la descente du ventre.",
      "file": "c006.ogg",
      "durationSec": 5.808
    },
    {
      "index": 7,
      "text": "Choisissez un endroit pour retenir votre attention.",
      "file": "c007.ogg",
      "durationSec": 6.192
    },
    {
      "index": 8,
      "text": "Lorsque l’esprit s’égare, revenez gentiment.",
      "file": "c008.ogg",
      "durationSec": 5.808
    },
    {
      "index": 9,
      "text": "Aucun jugement. Revenez simplement.",
      "file": "c009.ogg",
      "durationSec": 6.408
    },
    {
      "index": 10,
      "text": "Maintenant, si cela vous semble facile, comptez les cycles doux.",
      "file": "c010.ogg",
      "durationSec": 7.704
    },
    {
      "index": 11,
      "text": "Inhaler. Un.",
      "file": "c011.ogg",
      "durationSec": 4.632
    },
    {
      "index": 12,
      "text": "Exhaler. Un.",
      "file": "c012.ogg",
      "durationSec": 4.656
    },
    {
      "index": 13,
      "text": "Inhaler. Deux.",
      "file": "c013.ogg",
      "durationSec": 4.776
    },
    {
      "index": 14,
      "text": "Exhaler. Deux.",
      "file": "c014.ogg",
      "durationSec": 4.8
    },
    {
      "index": 15,
      "text": "Continuez jusqu'à cinq, puis recommencez à une heure.",
      "file": "c015.ogg",
      "durationSec": 6.888
    },
    {
      "index": 16,
      "text": "Si vous perdez le compte, recommencez avec bienveillance.",
      "file": "c016.ogg",
      "durationSec": 7.128
    },
    {
      "index": 17,
      "text": "Le retour est la pratique.",
      "file": "c017.ogg",
      "durationSec": 4.128
    },
    {
      "index": 18,
      "text": "Laissez la respiration être naturelle. Aucune contrainte.",
      "file": "c018.ogg",
      "durationSec": 8.784
    },
    {
      "index": 19,
      "text": "Encore quelques cycles en silence.",
      "file": "c019.ogg",
      "durationSec": 4.608
    },
    {
      "index": 20,
      "text": "Relâchez le décompte.",
      "file": "c020.ogg",
      "durationSec": 3.84
    },
    {
      "index": 21,
      "text": "Restez en conscience ouverte pendant un moment.",
      "file": "c021.ogg",
      "durationSec": 5.568
    },
    {
      "index": 22,
      "text": "Lorsque vous êtes prêt, ouvrez les yeux.",
      "file": "c022.ogg",
      "durationSec": 5.304
    }
  ]
}
