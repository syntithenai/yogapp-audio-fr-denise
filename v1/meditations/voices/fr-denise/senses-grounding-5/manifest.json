  "chunks": [
    {
      "index": 0,
      "text": "Accueillir.",
      "file": "c000.ogg",
      "durationSec": 2.88
    },
    {
      "index": 1,
      "text": "Si vous vous sentez dispersé ou activé, cette pratique peut vous aider.",
      "file": "c001.ogg",
      "durationSec": 8.088
    },
    {
      "index": 2,
      "text": "Gardez les yeux ouverts pour le moment, si cela vous semble plus sûr.",
      "file": "c002.ogg",
      "durationSec": 7.584
    },
    {
      "index": 3,
      "text": "Plantez les deux pieds au sol.",
      "file": "c003.ogg",
      "durationSec": 4.272
    },
    {
      "index": 4,
      "text": "[pause : 17]",
      "file": "c004.ogg",
      "durationSec": 3.888
    },
    {
      "index": 5,
      "text": "Nommez cinq choses que vous pouvez voir.",
      "file": "c005.ogg",
      "durationSec": 5.064
    },
    {
      "index": 6,
      "text": "Tranquillement. Prenez votre temps.",
      "file": "c006.ogg",
      "durationSec": 6.0
    },
    {
      "index": 7,
      "text": "[pause : 45]",
      "file": "c007.ogg",
      "durationSec": 4.272
    },
    {
      "index": 8,
      "text": "Nommez quatre choses que vous pouvez ressentir ou toucher.",
      "file": "c008.ogg",
      "durationSec": 6.288
    },
    {
      "index": 9,
      "text": "Vêtements. Chaise. Air sur la peau. Pieds au sol.",
      "file": "c009.ogg",
      "durationSec": 11.016
    },
    {
      "index": 10,
      "text": "[pause : 39]",
      "file": "c010.ogg",
      "durationSec": 4.056
    },
    {
      "index": 11,
      "text": "Nommez trois sons.",
      "file": "c011.ogg",
      "durationSec": 3.336
    },
    {
      "index": 12,
      "text": "De près ou de loin. Doux ou clair.",
      "file": "c012.ogg",
      "durationSec": 6.624
    },
    {
      "index": 13,
      "text": "[pause : 39]",
      "file": "c013.ogg",
      "durationSec": 4.056
    },
    {
      "index": 14,
      "text": "Nommez deux parfums ou remarquez simplement la qualité de l’air.",
      "file": "c014.ogg",
      "durationSec": 7.032
    },
    {
      "index": 15,
      "text": "[pause : 28]",
      "file": "c015.ogg",
      "durationSec": 4.104
    },
    {
      "index": 16,
      "text": "Nommez un goût ou une sensation dans la bouche.",
      "file": "c016.ogg",
      "durationSec": 5.616
    },
    {
      "index": 17,
      "text": "[pause : 23]",
      "file": "c017.ogg",
      "durationSec": 4.008
    },
    {
      "index": 18,
      "text": "Vous êtes ici. Dans ce corps. Dans cette pièce.",
      "file": "c018.ogg",
      "durationSec": 9.576
    },
    {
      "index": 19,
      "text": "Inspirez pendant quatre.",
      "file": "c019.ogg",
      "durationSec": 3.936
    },
    {
      "index": 20,
      "text": "Sortie pour six heures.",
      "file": "c020.ogg",
      "durationSec": 3.672
    },
    {
      "index": 21,
      "text": "[pause : 23]",
      "file": "c021.ogg",
      "durationSec": 4.008
    },
    {
      "index": 22,
      "text": "Respirez encore une fois.",
      "file": "c022.ogg",
      "durationSec": 4.08
    },
    {
      "index": 23,
      "text": "Remuez les doigts.",
      "file": "c023.ogg",
      "durationSec": 3.24
    },
    {
      "index": 24,
      "text": "Lorsque vous êtes prêt, ouvrez les yeux.",
      "file": "c024.ogg",
      "durationSec": 5.304
    },
    {
      "index": 25,
      "text": "Emportez-en un peu avec vous.",
      "file": "c025.ogg",
      "durationSec": 4.176
    }
  ]
}
