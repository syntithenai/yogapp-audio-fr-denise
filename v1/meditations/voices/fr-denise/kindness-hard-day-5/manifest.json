    },
    {
      "index": 14,
      "text": "[pause : 31]",
      "file": "c014.ogg",
      "durationSec": 3.84
    },
    {
      "index": 15,
      "text": "Puisse demain demander seulement ce que je peux donner.",
      "file": "c015.ogg",
      "durationSec": 5.784
    },
    {
      "index": 16,
      "text": "[pause : 31]",
      "file": "c016.ogg",
      "durationSec": 3.84
    },
    {
      "index": 17,
      "text": "Sentez le corps soutenu.",
      "file": "c017.ogg",
      "durationSec": 4.032
    },
    {
      "index": 18,
      "text": "Rien de plus n'est requis dans cette minute.",
