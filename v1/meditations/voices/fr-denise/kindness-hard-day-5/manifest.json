    {
      "index": 0,
      "text": "Accueillir.",
      "file": "c000.ogg",
      "durationSec": 2.88
    },
    {
      "index": 1,
      "text": "Trouvez un siège confortable ou allongez-vous si vous vous sentez mieux.",
      "file": "c001.ogg",
      "durationSec": 7.08
    },
    {
      "index": 2,
      "text": "Laissez les mains se reposer.",
      "file": "c002.ogg",
      "durationSec": 4.08
    },
    {
      "index": 3,
      "text": "Adoucissez les yeux ou fermez-les.",
      "file": "c003.ogg",
      "durationSec": 4.512
    },
    {
      "index": 4,
      "text": "Inspirez lentement.",
      "file": "c004.ogg",
      "durationSec": 3.408
    },
    {
      "index": 5,
      "text": "Et une expiration plus longue.",
      "file": "c005.ogg",
      "durationSec": 4.416
    },
    {
      "index": 6,
      "text": "Vous n’avez pas besoin de prétendre que c’était facile.",
      "file": "c006.ogg",
      "durationSec": 6.216
    },
    {
      "index": 7,
      "text": "Que la vérité de la fatigue soit permise.",
      "file": "c007.ogg",
      "durationSec": 5.352
    },
    {
      "index": 8,
      "text": "[pause : 31]",
      "file": "c008.ogg",
      "durationSec": 3.84
    },
    {
      "index": 9,
      "text": "Respirez avec soin.",
      "file": "c009.ogg",
      "durationSec": 3.72
    },
    {
      "index": 10,
      "text": "Expirez l’exigence d’aller bien.",
      "file": "c010.ogg",
      "durationSec": 4.608
    },
    {
      "index": 11,
      "text": "[pause : 31]",
      "file": "c011.ogg",
      "durationSec": 3.84
    },
    {
      "index": 12,
      "text": "Puis-je être doux avec moi-même ce soir.",
      "file": "c012.ogg",
      "durationSec": 5.064
    },
    {
      "index": 13,
      "text": "Puis-je me reposer tel que je suis.",
